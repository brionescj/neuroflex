+import { describe, expect, it } from "vitest";
+
+import {
+  ageAt,
+  buildStudentSnapshot,
+  isAttemptGameId,
+  parseAttemptInfo,
+  parseCloseStatus,
+  parseDeviceInfo,
+  parseLevelReport,
+  scoreMiniCaseOrder,
+  summarizeResults,
+} from "./gameAttempts";
+
+const NOW = new Date("2026-10-14T12:00:00.000Z");
+
+const validAttempt = {
+  attemptId: "abcdefgh12345678",
+  sessionId: "sess-1234567890",
+  startedAt: "2026-10-14T11:00:00.000Z",
+  contentVersion: "color-sequence-1",
+  device: { pointer: "touch", viewportWidth: 390, viewportHeight: 800 },
+};
+
+describe("isAttemptGameId", () => {
+  it("acepta solo los tres juegos", () => {
+    expect(isAttemptGameId("color-sequence")).toBe(true);
+    expect(isAttemptGameId("mini-cases")).toBe(true);
+    expect(isAttemptGameId("node-connection")).toBe(true);
+    expect(isAttemptGameId("otro")).toBe(false);
+    expect(isAttemptGameId(undefined)).toBe(false);
+  });
+});
+
+describe("parseAttemptInfo", () => {
+  it("acepta un bloque valido", () => {
+    const parsed = parseAttemptInfo(validAttempt, NOW);
+
+    expect(parsed.ok).toBe(true);
+    if (parsed.ok) {
+      expect(parsed.value.attemptId).toBe("abcdefgh12345678");
+      expect(parsed.value.startedAt.toISOString()).toBe(
+        "2026-10-14T11:00:00.000Z",
+      );
+      expect(parsed.value.device.pointer).toBe("touch");
+    }
+  });
+
+  it("rechaza identificadores malos", () => {
+    expect(parseAttemptInfo(null, NOW).ok).toBe(false);
+    expect(parseAttemptInfo({ ...validAttempt, attemptId: "corto" }, NOW).ok).toBe(false);
+    expect(
+      parseAttemptInfo({ ...validAttempt, attemptId: "con espacios aqui" }, NOW).ok,
+    ).toBe(false);
+    expect(parseAttemptInfo({ ...validAttempt, sessionId: 5 }, NOW).ok).toBe(false);
+  });
+
+  it("una fecha futura o absurda se reemplaza por la hora del servidor", () => {
+    for (const startedAt of ["2030-01-01T00:00:00Z", "no es fecha", "1990-01-01T00:00:00Z", 7]) {
+      const parsed = parseAttemptInfo({ ...validAttempt, startedAt }, NOW);
+
+      expect(parsed.ok && parsed.value.startedAt.getTime()).toBe(NOW.getTime());
+    }
+  });
+});
+
+describe("parseDeviceInfo", () => {
+  it("rellena valores por defecto ante basura", () => {
+    expect(parseDeviceInfo("x")).toMatchObject({
+      pointer: "mixed",
+      viewportWidth: 0,
+      pixelRatio: 1,
+      platform: "desconocido",
+    });
+  });
+
+  it("acota textos y descarta numeros fuera de rango", () => {
+    const info = parseDeviceInfo({
+      pointer: "mouse",
+      viewportWidth: -5,
+      pixelRatio: 99,
+      platform: "x".repeat(500),
+    });
+
+    expect(info.viewportWidth).toBe(0);
+    expect(info.pixelRatio).toBe(1);
+    expect(info.platform).toHaveLength(60);
+  });
+});
+
+describe("parseLevelReport", () => {
+  const seriacion = {
+    key: "3",
+    index: 3,
+    metrics: { sequenceLength: 5, correctCount: 4, percent: 80 },
+    activeMsGross: 12_000,
+    activeMsNet: 9_000,
+    completedAt: "2026-10-14T11:30:00.000Z",
+  };
+
+  it("acepta un nivel de seriacion y usa tryNumber 1 por defecto", () => {
+    const parsed = parseLevelReport("color-sequence", seriacion, NOW);
+
+    expect(parsed.ok).toBe(true);
+    if (parsed.ok) {
+      expect(parsed.value.tryNumber).toBe(1);
+      expect(parsed.value.orderedOptionKeys).toBeNull();
+    }
+  });
+
+  it("el neto nunca supera al bruto", () => {
+    const parsed = parseLevelReport(
+      "color-sequence",
+      { ...seriacion, activeMsNet: 50_000 },
+      NOW,
+    );
+
+    expect(parsed.ok && parsed.value.activeMsNet).toBe(12_000);
+  });
+
+  it("rechaza aciertos mayores que la secuencia", () => {
+    const parsed = parseLevelReport(
+      "color-sequence",
+      { ...seriacion, metrics: { sequenceLength: 3, correctCount: 4 } },
+      NOW,
+    );
+
+    expect(parsed.ok).toBe(false);
+  });
+
+  it("rechaza claves, indices y tiempos invalidos", () => {
+    expect(parseLevelReport("color-sequence", { ...seriacion, key: "a b" }, NOW).ok).toBe(false);
+    expect(parseLevelReport("color-sequence", { ...seriacion, index: 0 }, NOW).ok).toBe(false);
+    expect(parseLevelReport("color-sequence", { ...seriacion, activeMsGross: -1 }, NOW).ok).toBe(false);
+    expect(
+      parseLevelReport("color-sequence", { ...seriacion, activeMsGross: 25 * 3600 * 1000 }, NOW).ok,
+    ).toBe(false);
+    expect(parseLevelReport("color-sequence", null, NOW).ok).toBe(false);
+  });
+
+  it("rechaza metricas demasiado grandes o demasiado profundas", () => {
+    const big = { ...seriacion.metrics, extra: "x".repeat(25_000) };
+    const deep = { ...seriacion.metrics, a: { b: { c: { d: { e: { f: 1 } } } } } };
+
+    expect(parseLevelReport("color-sequence", { ...seriacion, metrics: big }, NOW).ok).toBe(false);
+    expect(parseLevelReport("color-sequence", { ...seriacion, metrics: deep }, NOW).ok).toBe(false);
+  });
+
+  it("valida las metricas de nodos", () => {
+    const nodes = {
+      key: "2",
+      index: 2,
+      metrics: { pairCount: 3, undoCount: 1, resetCount: 0 },
+      activeMsGross: 5000,
+      activeMsNet: 5000,
+      completedAt: "2026-10-14T11:30:00.000Z",
+    };
+
+    expect(parseLevelReport("node-connection", nodes, NOW).ok).toBe(true);
+    expect(
+      parseLevelReport("node-connection", { ...nodes, metrics: { pairCount: 3 } }, NOW).ok,
+    ).toBe(false);
+  });
+
+  it("mini casos exige exactamente 4 opciones ordenadas", () => {
+    const caso = {
+      key: "caso-1",
+      index: 1,
+      metrics: {},
+      activeMsGross: 4000,
+      activeMsNet: 4000,
+      completedAt: "2026-10-14T11:30:00.000Z",
+      orderedOptionKeys: ["a", "b", "c", "d"],
+    };
+
+    const ok = parseLevelReport("mini-cases", caso, NOW);
+
+    expect(ok.ok && ok.value.orderedOptionKeys).toEqual(["a", "b", "c", "d"]);
+    expect(
+      parseLevelReport("mini-cases", { ...caso, orderedOptionKeys: ["a", "b"] }, NOW).ok,
+    ).toBe(false);
+    expect(
+      parseLevelReport("mini-cases", { ...caso, orderedOptionKeys: undefined }, NOW).ok,
+    ).toBe(false);
+    expect(
+      parseLevelReport("mini-cases", { ...caso, orderedOptionKeys: ["a", "b", "c", 4] }, NOW).ok,
+    ).toBe(false);
+  });
+});
+
+describe("parseCloseStatus", () => {
+  it("acepta finished y failed", () => {
+    expect(parseCloseStatus("finished")).toEqual({ ok: true, value: "finished" });
+    expect(parseCloseStatus("failed")).toEqual({ ok: true, value: "failed" });
+    expect(parseCloseStatus("in_progress").ok).toBe(false);
+  });
+});
+
+describe("ageAt", () => {
+  const at = new Date("2026-10-14T12:00:00.000Z");
+
+  it("calcula anos cumplidos en ambos formatos", () => {
+    expect(ageAt("2000-10-14", at)).toBe(26);
+    expect(ageAt("14-10-2000", at)).toBe(26);
+    expect(ageAt("14/10/2000", at)).toBe(26);
+  });
+
+  it("no cuenta el cumpleanos que aun no llega", () => {
+    expect(ageAt("2000-10-15", at)).toBe(25);
+    expect(ageAt("2000-11-01", at)).toBe(25);
+  });
+
+  it("devuelve null ante datos faltantes, raros o fuera de rango", () => {
+    expect(ageAt(null, at)).toBeNull();
+    expect(ageAt("", at)).toBeNull();
+    expect(ageAt("ayer", at)).toBeNull();
+    expect(ageAt("2000-13-01", at)).toBeNull();
+    expect(ageAt("2025-01-01", at)).toBeNull();
+    expect(ageAt("1800-01-01", at)).toBeNull();
+  });
+});
+
+describe("buildStudentSnapshot", () => {
+  it("copia los datos presentes y deja null los ausentes", () => {
+    const snapshot = buildStudentSnapshot(
+      {
+        paralelo: 2,
+        entryYear: 2024,
+        birthDate: "2000-01-01",
+        ciudad: " Temuco ",
+        region: "La Araucania",
+      },
+      NOW,
+    );
+
+    expect(snapshot).toEqual({
+      paralelo: 2,
+      entryYear: 2024,
+      ageAtStart: 26,
+      studyShift: null,
+      ciudad: "Temuco",
+      region: "La Araucania",
+      gender: null,
+      university: null,
+      studyPlan: null,
+    });
+  });
+
+  it("sin ficha del estudiante todo queda null", () => {
+    expect(Object.values(buildStudentSnapshot(null, NOW)).every((v) => v === null)).toBe(true);
+  });
+});
+
+describe("summarizeResults", () => {
+  it("seriacion: nivel maximo y aciertos", () => {
+    const summary = summarizeResults("color-sequence", [
+      { index: 1, tryNumber: 1, metrics: { sequenceLength: 3, correctCount: 3 }, activeMsGross: 1000, activeMsNet: 900 },
+      { index: 2, tryNumber: 1, metrics: { sequenceLength: 4, correctCount: 2 }, activeMsGross: 2000, activeMsNet: 1500 },
+    ]);
+
+    expect(summary).toMatchObject({
+      levelsReported: 2,
+      maxLevel: 2,
+      totalCorrect: 5,
+      totalItems: 7,
+      activeMsGross: 3000,
+      activeMsNet: 2400,
+    });
+  });
+
+  it("nodos: deshacer y reiniciar", () => {
+    const summary = summarizeResults("node-connection", [
+      { index: 1, tryNumber: 1, metrics: { undoCount: 2, resetCount: 1 }, activeMsGross: 1, activeMsNet: 1 },
+      { index: 2, tryNumber: 1, metrics: { undoCount: 3, resetCount: 0 }, activeMsGross: 1, activeMsNet: 1 },
+    ]);
+
+    expect(summary).toMatchObject({ maxLevel: 2, totalUndo: 5, totalReset: 1 });
+  });
+
+  it("mini casos: pasos correctos y casos perfectos", () => {
+    const summary = summarizeResults("mini-cases", [
+      { index: 1, tryNumber: 1, metrics: { correctSteps: 4, isFullyCorrect: true }, activeMsGross: 1, activeMsNet: 1 },
+      { index: 2, tryNumber: 1, metrics: { correctSteps: 2, isFullyCorrect: false }, activeMsGross: 1, activeMsNet: 1 },
+    ]);
+
+    expect(summary).toMatchObject({ totalCorrectSteps: 6, fullyCorrectCases: 1 });
+  });
+
+  it("sin resultados no inventa nada", () => {
+    expect(summarizeResults("color-sequence", [])).toMatchObject({
+      levelsReported: 0,
+      maxLevel: 0,
+      activeMsGross: 0,
+    });
+  });
+});
+
+describe("scoreMiniCaseOrder", () => {
+  const options = [
+    { optionKey: "a", correctStep: 1 },
+    { optionKey: "b", correctStep: 2 },
+    { optionKey: "c", correctStep: 3 },
+    { optionKey: "d", correctStep: 4 },
+  ];
+
+  it("orden perfecto", () => {
+    expect(scoreMiniCaseOrder(options, ["a", "b", "c", "d"])).toEqual({
+      correctSteps: 4,
+      isFullyCorrect: true,
+    });
+  });
+
+  it("cuenta solo los pasos en su lugar", () => {
+    expect(scoreMiniCaseOrder(options, ["b", "a", "c", "d"])).toEqual({
+      correctSteps: 2,
+      isFullyCorrect: false,
+    });
+  });
+
+  it("una opcion desconocida no suma", () => {
+    expect(scoreMiniCaseOrder(options, ["x", "b", "c", "d"]).correctSteps).toBe(3);
+  });
+});
diff --git a/lib/gameAttempts.ts b/lib/gameAttempts.ts
new file mode 100644
index 0000000..452d4ab
--- /dev/null
+++ b/lib/gameAttempts.ts
@@ -0,0 +1,461 @@
+/**
+ * Reglas puras (sin base de datos) del registro de partidas: validan lo que
+ * manda el navegador, calculan la edad y resumen de un intento. Viven aparte
+ * del endpoint para poder probarlas con tests.
+ *
+ * El navegador es una fuente poco confiable: todo se valida y se acota
+ * (tipos, rangos, tamano) antes de guardarse.
+ */
+
+export const ATTEMPT_GAME_IDS = [
+  "color-sequence",
+  "mini-cases",
+  "node-connection",
+] as const;
+
+export type AttemptGameId = (typeof ATTEMPT_GAME_IDS)[number];
+
+export function isAttemptGameId(value: unknown): value is AttemptGameId {
+  return (
+    typeof value === "string" &&
+    (ATTEMPT_GAME_IDS as readonly string[]).includes(value)
+  );
+}
+
+export type DevicePointer = "touch" | "mouse" | "mixed";
+
+export type DeviceInfo = {
+  pointer: DevicePointer;
+  viewportWidth: number;
+  viewportHeight: number;
+  pixelRatio: number;
+  platform: string;
+  browser: string;
+  timeZone: string;
+  language: string;
+};
+
+export type AttemptInfo = {
+  attemptId: string;
+  startedAt: Date;
+  contentVersion: string;
+  sessionId: string;
+  device: DeviceInfo;
+};
+
+export type LevelReport = {
+  /** Unico dentro del intento: "3" (nivel) o el caseKey (mini casos). */
+  key: string;
+  /** Posicion en la partida: nivel o numero de caso, desde 1. */
+  index: number;
+  tryNumber: number;
+  metrics: Record<string, unknown>;
+  activeMsGross: number;
+  activeMsNet: number;
+  completedAt: Date;
+  orderedOptionKeys: string[] | null;
+};
+
+export type AttemptCloseStatus = "finished" | "failed";
+
+export type ParseResult<T> =
+  | { ok: true; value: T }
+  | { ok: false; message: string };
+
+const ID_PATTERN = /^[A-Za-z0-9_-]{8,64}$/;
+const KEY_PATTERN = /^[A-Za-z0-9_.:-]{1,64}$/;
+
+const MAX_ACTIVE_MS = 24 * 60 * 60 * 1000;
+const MAX_METRICS_BYTES = 20_000;
+const MAX_JSON_DEPTH = 4;
+
+/** Tolerancia entre el reloj del navegador y el del servidor. */
+const CLOCK_SKEW_MS = 5 * 60 * 1000;
+const MAX_PAST_MS = 400 * 24 * 60 * 60 * 1000;
+
+function fail<T>(message: string): ParseResult<T> {
+  return { ok: false, message };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isInt(value: unknown, min: number, max: number): value is number {
+  return (
+    typeof value === "number" &&
+    Number.isInteger(value) &&
+    value >= min &&
+    value <= max
+  );
+}
+
+function isTimeMs(value: unknown): value is number {
+  return (
+    typeof value === "number" &&
+    Number.isFinite(value) &&
+    value >= 0 &&
+    value <= MAX_ACTIVE_MS
+  );
+}
+
+function shortText(value: unknown, fallback: string): string {
+  return typeof value === "string" && value.length > 0
+    ? value.slice(0, 60)
+    : fallback;
+}
+
+/** Solo JSON plano y acotado: sin funciones, NaN ni estructuras profundas. */
+function isBoundedJson(value: unknown, depth = 0): boolean {
+  if (depth > MAX_JSON_DEPTH) return false;
+  if (value === null) return true;
+
+  switch (typeof value) {
+    case "string":
+    case "boolean":
+      return true;
+    case "number":
+      return Number.isFinite(value);
+    case "object":
+      if (Array.isArray(value)) {
+        return value.every((item) => isBoundedJson(item, depth + 1));
+      }
+      return Object.values(value as Record<string, unknown>).every((item) =>
+        isBoundedJson(item, depth + 1),
+      );
+    default:
+      return false;
+  }
+}
+
+function parseDate(value: unknown, now: Date): Date {
+  if (typeof value !== "string") return now;
+
+  const time = Date.parse(value);
+
+  if (
+    Number.isNaN(time) ||
+    time > now.getTime() + CLOCK_SKEW_MS ||
+    time < now.getTime() - MAX_PAST_MS
+  ) {
+    return now;
+  }
+
+  return new Date(time);
+}
+
+export function parseDeviceInfo(raw: unknown): DeviceInfo {
+  const r = isRecord(raw) ? raw : {};
+
+  const pointer: DevicePointer =
+    r.pointer === "touch" || r.pointer === "mouse" || r.pointer === "mixed"
+      ? r.pointer
+      : "mixed";
+
+  const dimension = (value: unknown) =>
+    isInt(value, 0, 20_000) ? value : 0;
+
+  const pixelRatio =
+    typeof r.pixelRatio === "number" &&
+    Number.isFinite(r.pixelRatio) &&
+    r.pixelRatio > 0 &&
+    r.pixelRatio <= 10
+      ? r.pixelRatio
+      : 1;
+
+  return {
+    pointer,
+    viewportWidth: dimension(r.viewportWidth),
+    viewportHeight: dimension(r.viewportHeight),
+    pixelRatio,
+    platform: shortText(r.platform, "desconocido"),
+    browser: shortText(r.browser, "desconocido"),
+    timeZone: shortText(r.timeZone, "desconocida"),
+    language: shortText(r.language, "desconocido"),
+  };
+}
+
+export function parseAttemptInfo(
+  raw: unknown,
+  now: Date = new Date(),
+): ParseResult<AttemptInfo> {
+  if (!isRecord(raw)) return fail("Falta el bloque attempt.");
+
+  if (typeof raw.attemptId !== "string" || !ID_PATTERN.test(raw.attemptId)) {
+    return fail("attemptId invalido.");
+  }
+
+  if (typeof raw.sessionId !== "string" || !ID_PATTERN.test(raw.sessionId)) {
+    return fail("sessionId invalido.");
+  }
+
+  return {
+    ok: true,
+    value: {
+      attemptId: raw.attemptId,
+      sessionId: raw.sessionId,
+      startedAt: parseDate(raw.startedAt, now),
+      contentVersion: shortText(raw.contentVersion, "sin-version"),
+      device: parseDeviceInfo(raw.device),
+    },
+  };
+}
+
+function parseMetrics(
+  gameId: AttemptGameId,
+  raw: unknown,
+): ParseResult<Record<string, unknown>> {
+  if (!isRecord(raw)) return fail("metrics debe ser un objeto.");
+
+  if (!isBoundedJson(raw) || JSON.stringify(raw).length > MAX_METRICS_BYTES) {
+    return fail("metrics invalido o demasiado grande.");
+  }
+
+  if (gameId === "color-sequence") {
+    if (
+      !isInt(raw.sequenceLength, 1, 5000) ||
+      !isInt(raw.correctCount, 0, 5000) ||
+      raw.correctCount > raw.sequenceLength
+    ) {
+      return fail("metrics de seriacion invalido.");
+    }
+  }
+
+  if (gameId === "node-connection") {
+    if (
+      !isInt(raw.pairCount, 1, 50) ||
+      !isInt(raw.undoCount, 0, 100_000) ||
+      !isInt(raw.resetCount, 0, 100_000)
+    ) {
+      return fail("metrics de nodos invalido.");
+    }
+  }
+
+  return { ok: true, value: raw };
+}
+
+export function parseLevelReport(
+  gameId: AttemptGameId,
+  raw: unknown,
+  now: Date = new Date(),
+): ParseResult<LevelReport> {
+  if (!isRecord(raw)) return fail("Falta el bloque result.");
+
+  if (typeof raw.key !== "string" || !KEY_PATTERN.test(raw.key)) {
+    return fail("key invalida.");
+  }
+
+  if (!isInt(raw.index, 1, 10_000)) return fail("index invalido.");
+
+  const tryNumber = raw.tryNumber === undefined ? 1 : raw.tryNumber;
+  if (!isInt(tryNumber, 1, 1000)) return fail("tryNumber invalido.");
+
+  if (!isTimeMs(raw.activeMsGross) || !isTimeMs(raw.activeMsNet)) {
+    return fail("Tiempos activos invalidos.");
+  }
+
+  const metrics = parseMetrics(gameId, raw.metrics);
+  if (!metrics.ok) return metrics;
+
+  let orderedOptionKeys: string[] | null = null;
+
+  if (gameId === "mini-cases") {
+    const keys = raw.orderedOptionKeys;
+
+    if (
+      !Array.isArray(keys) ||
+      keys.length !== 4 ||
+      !keys.every((k) => typeof k === "string" && KEY_PATTERN.test(k))
+    ) {
+      return fail("orderedOptionKeys debe tener 4 opciones validas.");
+    }
+
+    orderedOptionKeys = keys as string[];
+  }
+
+  return {
+    ok: true,
+    value: {
+      key: raw.key,
+      index: raw.index,
+      tryNumber,
+      metrics: metrics.value,
+      activeMsGross: raw.activeMsGross,
+      // El tiempo neto nunca puede superar al bruto.
+      activeMsNet: Math.min(raw.activeMsNet, raw.activeMsGross),
+      completedAt: parseDate(raw.completedAt, now),
+      orderedOptionKeys,
+    },
+  };
+}
+
+export function parseCloseStatus(
+  raw: unknown,
+): ParseResult<AttemptCloseStatus> {
+  if (raw === "finished" || raw === "failed") return { ok: true, value: raw };
+
+  return fail("status invalido.");
+}
+
+/**
+ * Edad en anos cumplidos a la fecha `at`. Acepta AAAA-MM-DD y DD-MM-AAAA (o
+ * con "/"). Devuelve null si falta o no se entiende: nunca se inventa.
+ */
+export function ageAt(
+  birthDate: string | null | undefined,
+  at: Date,
+): number | null {
+  if (!birthDate) return null;
+
+  const text = birthDate.trim();
+  let year: number;
+  let month: number;
+  let day: number;
+
+  const iso = /^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/.exec(text);
+  const latin = /^(\d{1,2})[-/](\d{1,2})[-/](\d{4})$/.exec(text);
+
+  if (iso) {
+    year = Number(iso[1]);
+    month = Number(iso[2]);
+    day = Number(iso[3]);
+  } else if (latin) {
+    day = Number(latin[1]);
+    month = Number(latin[2]);
+    year = Number(latin[3]);
+  } else {
+    return null;
+  }
+
+  if (month < 1 || month > 12 || day < 1 || day > 31) return null;
+
+  let age = at.getUTCFullYear() - year;
+  const atMonth = at.getUTCMonth() + 1;
+
+  if (atMonth < month || (atMonth === month && at.getUTCDate() < day)) {
+    age -= 1;
+  }
+
+  return age >= 10 && age <= 100 ? age : null;
+}
+
+export type StudentSnapshot = {
+  paralelo: number | null;
+  entryYear: number | null;
+  ageAtStart: number | null;
+  studyShift: string | null;
+  ciudad: string | null;
+  region: string | null;
+  // Los carga el admin mas adelante; hasta entonces quedan vacios.
+  gender: string | null;
+  university: string | null;
+  studyPlan: string | null;
+};
+
+function textOrNull(value: unknown): string | null {
+  return typeof value === "string" && value.trim() !== ""
+    ? value.trim().slice(0, 80)
+    : null;
+}
+
+function numberOrNull(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+/**
+ * Copia los datos del estudiante con los que se agrupa despues. Se guarda
+ * una foto en cada intento: si el alumno cambia de paralelo o ciudad, sus
+ * intentos antiguos conservan lo que valia cuando jugo.
+ */
+export function buildStudentSnapshot(
+  student: Record<string, unknown> | null,
+  startedAt: Date,
+): StudentSnapshot {
+  const s = student ?? {};
+
+  return {
+    paralelo: numberOrNull(s.paralelo),
+    entryYear: numberOrNull(s.entryYear),
+    ageAtStart: ageAt(
+      typeof s.birthDate === "string" ? s.birthDate : null,
+      startedAt,
+    ),
+    studyShift: textOrNull(s.studyShift),
+    ciudad: textOrNull(s.ciudad),
+    region: textOrNull(s.region),
+    gender: textOrNull(s.gender),
+    university: textOrNull(s.university),
+    studyPlan: textOrNull(s.studyPlan),
+  };
+}
+
+export type StoredResult = {
+  index: number;
+  tryNumber: number;
+  metrics: Record<string, unknown>;
+  activeMsGross: number;
+  activeMsNet: number;
+};
+
+function num(value: unknown): number {
+  return typeof value === "number" && Number.isFinite(value) ? value : 0;
+}
+
+/** Resumen del intento, recalculado SIEMPRE desde los resultados guardados. */
+export function summarizeResults(
+  gameId: AttemptGameId,
+  results: StoredResult[],
+): Record<string, number> {
+  const common = {
+    levelsReported: results.length,
+    activeMsGross: results.reduce((sum, r) => sum + r.activeMsGross, 0),
+    activeMsNet: results.reduce((sum, r) => sum + r.activeMsNet, 0),
+  };
+
+  if (gameId === "color-sequence") {
+    return {
+      ...common,
+      maxLevel: results.reduce((max, r) => Math.max(max, r.index), 0),
+      totalCorrect: results.reduce((s, r) => s + num(r.metrics.correctCount), 0),
+      totalItems: results.reduce((s, r) => s + num(r.metrics.sequenceLength), 0),
+    };
+  }
+
+  if (gameId === "node-connection") {
+    return {
+      ...common,
+      maxLevel: results.reduce((max, r) => Math.max(max, r.index), 0),
+      totalUndo: results.reduce((s, r) => s + num(r.metrics.undoCount), 0),
+      totalReset: results.reduce((s, r) => s + num(r.metrics.resetCount), 0),
+    };
+  }
+
+  return {
+    ...common,
+    totalCorrectSteps: results.reduce(
+      (s, r) => s + num(r.metrics.correctSteps),
+      0,
+    ),
+    fullyCorrectCases: results.filter((r) => r.metrics.isFullyCorrect === true)
+      .length,
+  };
+}
+
+export type ScoredOption = { optionKey: string; correctStep: number };
+
+/**
+ * Pasos que el estudiante dejo en su lugar correcto. Es la unica
+ * implementacion del puntaje: la usan el envio de cada caso y el registro de
+ * la partida, para que ambos nunca discrepen.
+ */
+export function scoreMiniCaseOrder(
+  options: ScoredOption[],
+  orderedOptionKeys: string[],
+): { correctSteps: number; isFullyCorrect: boolean } {
+  const correctSteps = orderedOptionKeys.filter((optionKey, index) => {
+    const option = options.find((o) => o.optionKey === optionKey);
+    return option?.correctStep === index + 1;
+  }).length;
+
+  return { correctSteps, isFullyCorrect: correctSteps === options.length };
+}
