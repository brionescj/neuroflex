@@ -0,0 +1,119 @@
+import type { VercelRequest, VercelResponse } from "@vercel/node";
+
+import { requireAuth } from "../../lib/auth";
+import { connectDB } from "../../lib/db";
+import {
+  isAttemptGameId,
+  parseAttemptInfo,
+  parseCloseStatus,
+  parseLevelReport,
+} from "../../lib/gameAttempts";
+import {
+  closeAttempt,
+  ensureAttempt,
+  saveLevelResult,
+} from "../../lib/gameAttemptsStore";
+
+/**
+ * Registro de partidas para el analisis. POST con dos formas:
+ *   { type: "level", attempt, result }  guarda un nivel o caso
+ *   { type: "close", attempt, status }  cierra el intento
+ * Ambas son idempotentes: reenviar lo mismo no duplica nada, de modo que el
+ * navegador puede reintentar sin riesgo.
+ */
+export default async function handler(
+  req: VercelRequest,
+  res: VercelResponse,
+) {
+  if (req.method !== "POST") {
+    return res
+      .status(405)
+      .json({ success: false, message: "Metodo no permitido." });
+  }
+
+  const payload = requireAuth(req, res, ["student"]);
+  if (!payload) return;
+
+  const gameId = req.query.gameId;
+
+  if (!isAttemptGameId(gameId)) {
+    return res
+      .status(400)
+      .json({ success: false, message: "gameId invalido." });
+  }
+
+  const type = req.body?.type;
+
+  if (type !== "level" && type !== "close") {
+    return res
+      .status(400)
+      .json({ success: false, message: "type debe ser level o close." });
+  }
+
+  const info = parseAttemptInfo(req.body?.attempt);
+
+  if (!info.ok) {
+    return res.status(400).json({ success: false, message: info.message });
+  }
+
+  // Se valida todo antes de tocar la base.
+  const report =
+    type === "level" ? parseLevelReport(gameId, req.body?.result) : null;
+
+  if (report && !report.ok) {
+    return res.status(400).json({ success: false, message: report.message });
+  }
+
+  const status = type === "close" ? parseCloseStatus(req.body?.status) : null;
+
+  if (status && !status.ok) {
+    return res.status(400).json({ success: false, message: status.message });
+  }
+
+  await connectDB();
+
+  const attempt = await ensureAttempt(payload.rut, gameId, info.value);
+
+  if (!attempt) {
+    return res
+      .status(403)
+      .json({ success: false, message: "El intento no te pertenece." });
+  }
+
+  if (report?.ok) {
+    const outcome = await saveLevelResult(
+      payload.rut,
+      gameId,
+      attempt,
+      info.value.sessionId,
+      info.value.device,
+      report.value,
+    );
+
+    if (outcome === "unknown-case") {
+      return res
+        .status(404)
+        .json({ success: false, message: "Mini caso no encontrado." });
+    }
+
+    return res.status(200).json({
+      success: true,
+      message: "Resultado guardado.",
+      data: { attemptNumber: attempt.attemptNumber },
+    });
+  }
+
+  if (status?.ok) {
+    await closeAttempt(gameId, attempt, status.value);
+
+    return res.status(200).json({
+      success: true,
+      message: "Intento cerrado.",
+      data: { attemptNumber: attempt.attemptNumber },
+    });
+  }
+
+  return res
+    .status(400)
+    .json({ success: false, message: "Solicitud invalida." });
+}
