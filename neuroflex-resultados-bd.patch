+import { describe, expect, it } from "vitest";
+
+import type { MiniCaseResult } from "../types";
+import { toMiniCaseReport, toMiniCaseReports } from "./miniCaseReport";
+
+const FALLBACK = "2026-10-14T12:00:00.000Z";
+
+function makeResult(overrides: Partial<MiniCaseResult> = {}): MiniCaseResult {
+  return {
+    caseKey: "caso-1",
+    correctSteps: 3,
+    isFullyCorrect: false,
+    decisionTimeMs: 9000,
+    orderedOptionKeys: ["a", "b", "c", "d"],
+    activeMsNet: 7000,
+    completedAt: "2026-10-14T11:00:00.000Z",
+    ...overrides,
+  };
+}
+
+describe("toMiniCaseReport", () => {
+  it("arma el reporte con el orden elegido", () => {
+    expect(toMiniCaseReport(makeResult(), 2, FALLBACK)).toEqual({
+      key: "caso-1",
+      index: 2,
+      tryNumber: 1,
+      metrics: { decisionTimeMs: 9000 },
+      activeMsGross: 9000,
+      activeMsNet: 7000,
+      completedAt: "2026-10-14T11:00:00.000Z",
+      orderedOptionKeys: ["a", "b", "c", "d"],
+    });
+  });
+
+  it("devuelve null si no se guardo el orden (partida antigua)", () => {
+    const { orderedOptionKeys: _omit, ...legacy } = makeResult();
+
+    expect(toMiniCaseReport(legacy, 1, FALLBACK)).toBeNull();
+  });
+
+  it("sin neto ni fecha usa el bruto y la fecha de respaldo", () => {
+    const { activeMsNet: _n, completedAt: _c, ...partial } = makeResult();
+    const report = toMiniCaseReport(partial, 1, FALLBACK);
+
+    expect(report?.activeMsNet).toBe(9000);
+    expect(report?.completedAt).toBe(FALLBACK);
+  });
+
+  it("el neto nunca supera al bruto", () => {
+    const report = toMiniCaseReport(makeResult({ activeMsNet: 99_000 }), 1, FALLBACK);
+
+    expect(report?.activeMsNet).toBe(9000);
+  });
+});
+
+describe("toMiniCaseReports", () => {
+  it("numera por posicion y omite los resultados sin orden", () => {
+    const { orderedOptionKeys: _omit, ...legacy } = makeResult({ caseKey: "caso-2" });
+    const reports = toMiniCaseReports([
+      makeResult({ caseKey: "caso-1" }),
+      legacy,
+      makeResult({ caseKey: "caso-3" }),
+    ]);
+
+    expect(reports.map((r) => [r.key, r.index])).toEqual([
+      ["caso-1", 1],
+      ["caso-3", 3],
+    ]);
+  });
+});
diff --git a/src/features/games/mini-cases/hooks/miniCaseReport.ts b/src/features/games/mini-cases/hooks/miniCaseReport.ts
new file mode 100644
index 0000000..ddcbc76
--- /dev/null
+++ b/src/features/games/mini-cases/hooks/miniCaseReport.ts
@@ -0,0 +1,46 @@
+import type { LevelReport } from "../../attempts/types";
+import type { MiniCaseResult } from "../types";
+
+/**
+ * Convierte el resultado de un caso al formato del registro de partidas.
+ * Devuelve null si el resultado no guardo el orden elegido (partidas
+ * anteriores al registro): sin el orden el servidor no puede puntuarlo.
+ *
+ * `position` es el lugar del caso en esta partida, desde 1.
+ */
+export function toMiniCaseReport(
+  result: MiniCaseResult,
+  position: number,
+  fallbackDate: string,
+): LevelReport | null {
+  const ordered = result.orderedOptionKeys;
+
+  if (!ordered || ordered.length !== 4) return null;
+
+  const gross = result.decisionTimeMs;
+
+  return {
+    key: result.caseKey,
+    index: position,
+    tryNumber: 1,
+    metrics: { decisionTimeMs: gross },
+    activeMsGross: gross,
+    activeMsNet: Math.min(result.activeMsNet ?? gross, gross),
+    completedAt: result.completedAt ?? fallbackDate,
+    orderedOptionKeys: ordered,
+  };
+}
+
+/** Todos los reportes que se pueden armar; los resultados antiguos se omiten. */
+export function toMiniCaseReports(results: MiniCaseResult[]): LevelReport[] {
+  const now = new Date().toISOString();
+  const reports: LevelReport[] = [];
+
+  results.forEach((result, i) => {
+    const report = toMiniCaseReport(result, i + 1, now);
+
+    if (report) reports.push(report);
+  });
+
+  return reports;
+}
