+        </button>
+      )}
+
+      <p className="mt-1 text-xs leading-relaxed text-zinc-400">
+        Cada rango es un grupo del gráfico. Con un número de partida, cada uno muestra esa partida de quienes la
+        jugaron dentro de él. Hasta {max} rangos.
+      </p>
+    </fieldset>
+  );
+}
